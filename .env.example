# ==============================================================================
# Nextrade AI Environment Configuration (.env.example)
# Copy to .env and fill in your credentials.
# ==============================================================================

# Gemini AI API Key (injected automatically in AI Studio; required for live AI research)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Canonical HTTPS origin (used for SSR canonical tags, verification links, and CSRF)
APP_URL="MY_APP_URL"

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
GA_MEASUREMENT_ID=""

# Optional Google Search Console verification (meta content & optional .html filename)
GOOGLE_SITE_VERIFICATION=""
GOOGLE_SITE_VERIFICATION_FILE=""

# Database — Supabase PostgreSQL connection URI (Session or Transaction Pooler)
# When left blank, authentication falls back to local SQLite at AUTH_DB_PATH.
DATABASE_URL=""
SUPABASE_DB_URL=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
AUTH_DB_PATH=".data/nextrade-auth.sqlite"

# Transactional Email Delivery — EmailJS (default) or Resend
EMAIL_PROVIDER="emailjs"
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
EMAILJS_RESET_TEMPLATE_ID=""
EMAILJS_SECURITY_TEMPLATE_ID=""

# Optional Resend settings (used when EMAIL_PROVIDER="resend")
EMAIL_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="Nextrade AI"

# Optional dev-only email capture inside .data/dev-email-outbox/ (ignored in production)
AUTH_DEV_OUTBOX="false"

# Controlled Initial Super Admin Bootstrap (server-side only, never exposed to client)
# Set ADMIN_BOOTSTRAP_EMAIL (plus ADMIN_BOOTSTRAP_PASSWORD if account does not exist yet)
# Only runs when zero active super_admin accounts exist in the database.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME=""

# Optional Market Data Provider API Keys (Yahoo Finance, CoinGecko, and Frankfurter ECB FX work out of the box without keys)
FINNHUB_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
TWELVEDATA_API_KEY=""
